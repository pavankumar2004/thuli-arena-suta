# The stylist reads these on the server only (never sent to the browser).
# Put real values in lookbook/.env.local, or in the repo-root .env shared with the scraper.

# Neon Postgres holding the Task 1 `products` table (Dashboard -> Connect, pooled).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# OpenRouter key for the stylist's replies, photo search and try-ons (and the image scripts).
OPENROUTER_API_KEY=sk-or-v1-...
